{
  "name": "slateboxjs",
  "version": "3.1.3",
  "description": "Slatebox.js \u2014 modern diagramming library for mind mapping, concept drawing, and brainstorming. Ground-up rewrite on svg.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slatebox/slateboxjs.git"
  },
  "bugs": {
    "url": "https://github.com/Slatebox/slateboxjs/issues"
  },
  "homepage": "https://github.com/Slatebox/slateboxjs#readme",
  "main": "dist/slateboxjs.js",
  "module": "dist/slateboxjs.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/slateboxjs.mjs",
      "require": "./dist/slateboxjs.js"
    },
    "./style.css": "./dist/slateboxjs.css",
    "./dist/slateboxjs.css": "./dist/slateboxjs.css",
    "./workshops": {
      "types": "./dist/workshops/index.d.ts",
      "import": "./dist/workshops.mjs",
      "require": "./dist/workshops.cjs"
    },
    "./workshops/mount": {
      "types": "./dist/workshops/mount.d.ts",
      "import": "./dist/workshop-mount.mjs",
      "require": "./dist/workshop-mount.cjs"
    },
    "./workshops/model": {
      "types": "./dist/workshops/model.d.ts",
      "import": "./dist/workshop-model.mjs",
      "require": "./dist/workshop-model.cjs"
    },
    "./workshops/rules": {
      "types": "./dist/workshops/rules.d.ts",
      "import": "./dist/workshop-rules.mjs",
      "require": "./dist/workshop-rules.cjs"
    },
    "./workshops/samples": {
      "types": "./dist/workshops/samples.d.ts",
      "import": "./dist/workshop-samples.mjs",
      "require": "./dist/workshop-samples.cjs"
    },
    "./workshops/behaviour": {
      "types": "./dist/workshops/behaviour.d.ts",
      "import": "./dist/workshop-behaviour.mjs",
      "require": "./dist/workshop-behaviour.cjs"
    },
    "./catalog": {
      "types": "./dist/workshops/catalog.d.ts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.cjs"
    },
    "./shapes": {
      "types": "./dist/shapes/index.d.ts",
      "import": "./dist/shapes.mjs",
      "require": "./dist/shapes.cjs"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations.mjs",
      "require": "./dist/operations.cjs"
    },
    "./boards": {
      "types": "./dist/boards/index.d.ts",
      "import": "./dist/boards.mjs",
      "require": "./dist/boards.cjs"
    },
    "./boards/nest": {
      "types": "./dist/boards/nest.d.ts",
      "import": "./dist/boards-nest.mjs",
      "require": "./dist/boards-nest.cjs"
    },
    "./boards/grid": {
      "types": "./dist/boards/grid.d.ts",
      "import": "./dist/boards-grid.mjs",
      "require": "./dist/boards-grid.cjs"
    },
    "./boards/still": {
      "types": "./dist/boards/still.d.ts",
      "import": "./dist/boards-still.mjs",
      "require": "./dist/boards-still.cjs"
    },
    "./workshops/controls": {
      "types": "./dist/workshops/ruleControls.d.ts",
      "import": "./dist/workshop-controls.mjs",
      "require": "./dist/workshop-controls.cjs"
    },
    "./build.json": "./dist/BUILD.json",
    "./dragology": {
      "types": "./dist/dragology/index.d.ts",
      "import": "./dist/dragology.mjs",
      "require": "./dist/dragology.cjs"
    },
    "./presence": {
      "types": "./dist/core/AgentPresence.d.ts",
      "import": "./dist/presence.mjs",
      "require": "./dist/presence.cjs"
    },
    "./suggestions": {
      "types": "./dist/core/AgentSuggestions.d.ts",
      "import": "./dist/suggestions.mjs",
      "require": "./dist/suggestions.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.mjs",
      "require": "./dist/canvas.cjs"
    }
  },
  "files": [
    "dist",
    "workshops",
    "operations",
    "shapes",
    "boards",
    "dragology",
    "presence",
    "suggestions",
    "catalog",
    "licenses",
    "canvas"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.workshops.config.ts && vite build --config vite.canvas.config.ts && npm run build:types && node scripts/stamp-build.mjs",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist && node scripts/clean-declarations.mjs",
    "preview": "vite preview",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test tests/node/",
    "test:e2e": "npx playwright test --project=chromium",
    "test:app": "npx playwright test --config playwright.app.config.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:all": "npx playwright test",
    "test:all": "vitest run && npx playwright test --project=chromium",
    "verify:package": "node scripts/verify-package.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs"
  },
  "keywords": [
    "diagramming",
    "svg",
    "canvas",
    "nodes",
    "visualization"
  ],
  "author": "Tim Heckel <tim@slatebox.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "y-websocket": {
      "optional": true
    },
    "yjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dragology": "0.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "ws": "^8.21.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "dependencies": {
    "@svgdotjs/svg.draggable.js": "3.0.7",
    "@svgdotjs/svg.js": "3.2.8",
    "@svgdotjs/svg.panzoom.js": "2.1.3",
    "@svgdotjs/svg.resize.js": "2.0.7",
    "@svgdotjs/svg.select.js": "4.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
