# OS files
.DS_Store
Thumbs.db

# Environment and editor files
.env
.idea/
*.swo
*.swp

# Dependencies and build caches
node_modules/
# A worktree links node_modules to the main checkout's; a link is not a directory.
/node_modules
.vite/
# Per-worktree test and dev-server configs (own ports, own cache and output folders).
/*.local.config.ts

# Local agent and browser state
.codegraph/
graphify-out/
.playwright-mcp/
.reasonix/
.serena/
reasonix.toml

# Logs and generated test artifacts
*.log
playwright-report/
test-results/

# Root-level debug and package artifacts
/*.png
/dump.rdb
/slateboxjs-*.tgz

# Loop scheduler session state
.pi-loop.json
.pi-loop.json.lock
docs/.loop-marker
